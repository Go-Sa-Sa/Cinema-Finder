#!/bin/zsh -l
cd "$(dirname "$0")"
echo "========================================================"
echo "千葉7劇場の上映スケジュールを映画.comから最新取得します..."
echo "（スクレイピングには数分程度かかる場合があります）"
echo "========================================================"

python3 crawler.py
if [ $? -ne 0 ]; then
  echo "'python3' failed. Trying 'python'..."
  python crawler.py
  if [ $? -ne 0 ]; then
    echo ""
    echo "=================================================="
    echo "エラー: クローラーの実行に失敗しました。"
    echo "Pythonの環境またはインターネット接続を確認してください。"
    echo "=================================================="
    echo "Press [Enter] to close this window..."
    read
    exit 1
  fi
fi

echo ""
echo "========================================================"
echo "スケジュールの取得が正常に完了しました！"
echo "ブラウザ画面の「更新」ボタンを押すか、ページをリロードすると"
echo "最新のスケジュールが反映されます。"
echo "========================================================"
echo ""
echo "Press [Enter] to close this window..."
read
